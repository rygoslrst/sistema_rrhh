# Copia este archivo como ".env" y completa los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Clave para firmar la cookie de sesión de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase > Project Settings > API (o botón "Connect")
SUPABASE_URL=https://tu-proyecto.supabase.co
# Usa la clave PÚBLICA: "anon" (legacy) o "publishable".
# NUNCA uses la clave "service_role" / "secret" en este proyecto.
SUPABASE_KEY=
